# Copy to .env and fill in. Every key here is for a FREE tier; none needs a card.
# .env is gitignored and gitleaks scans every commit.

# https://openrouter.ai/settings/keys  (serves the :free Gemma / Nemotron / Qwen models)
OPENROUTER_API_KEY=replace-me

# https://cloud.cerebras.ai  (free tier: gpt-oss-120b)
CEREBRAS_API_KEY=replace-me

# Optional, only if you enable the groq teacher in config/teachers.toml
# https://console.groq.com/keys
GROQ_API_KEY=replace-me
