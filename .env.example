# Copy to .env and fill in THERE. This file is committed: never put a real key in it.
# All free tiers. Only Cerebras needs a card on file (for $5 of signup credit; keep
# auto-recharge OFF). .env is gitignored; gitleaks scans every commit.

# https://cloud.cerebras.ai  (council member: gpt-oss-120b)
CEREBRAS_API_KEY=replace-me

# https://console.groq.com/keys  (council member: Qwen 3.8 27B)
GROQ_API_KEY=replace-me

# https://aistudio.google.com/apikey  (council member: Gemma 4 31B)
GOOGLE_API_KEY=replace-me

# https://openrouter.ai/settings/keys  (tie-breaker only: 50 free requests/day)
OPENROUTER_API_KEY=replace-me
